#!/bin/sh
# CGI: GET ?format=json  → current mqtt.conf as JSON (password masked).
# POST x-www-form-urlencoded → write mqtt.conf, restart daemon, redirect home.
# shellcheck shell=sh disable=SC1091
set -u

APP_DIR="${APP_DIR:-/mnt/SDCARD/App/MQTTReporter}"
CONF="$APP_DIR/etc/mqtt.conf"
EXAMPLE="$APP_DIR/etc/mqtt.conf.example"

NL='
'
CR=$(printf '\r')

# ── url-decode helper ───────────────────────────────────────────────────────
url_decode() {
    awk -v s="$1" 'BEGIN{
        gsub(/\+/," ",s);
        out=""; n=length(s); i=1;
        while(i<=n){
            c=substr(s,i,1);
            if(c=="%" && i+2<=n){
                h=substr(s,i+1,2);
                out = out sprintf("%c", strtonum("0x" h));
                i+=3;
            } else { out=out c; i++; }
        }
        print out;
    }'
}

# Whitelist-validate a form value. Echoes the value if OK, exits non-zero otherwise.
validate() {
    local k="$1"
    local v="$2"
    case "$k" in
        MQTT_HOST)
            [ -n "$v" ] && [ ${#v} -le 253 ] || return 1
            printf '%s' "$v" | grep -Eq '^[A-Za-z0-9._-]+$' || return 1
            ;;
        MQTT_PORT|KEEPALIVE|INTERVAL)
            printf '%s' "$v" | grep -Eq '^[0-9]{1,5}$' || return 1
            ;;
        DEVICE_ID)
            [ -n "$v" ] && [ ${#v} -le 64 ] || return 1
            printf '%s' "$v" | grep -Eq '^[A-Za-z0-9_.-]+$' || return 1
            ;;
        MQTT_USER|MQTT_PASS)
            [ ${#v} -le 256 ] || return 1
            case "$v" in
                *'"'*|*"$NL"*|*"$CR"*) return 1 ;;
                *) : ;;
            esac
            ;;
        *) return 1 ;;
    esac
    printf '%s' "$v"
}

# Escape value for safe inclusion in a double-quoted shell string.
sh_quote() {
    # shellcheck disable=SC2016  # literal $ and ` are intentional inside single quotes
    printf '%s' "$1" | sed -e 's|\\|\\\\|g' -e 's|"|\\"|g' -e 's|`|\\`|g' -e 's|\$|\\$|g'
}

read_conf_value() {
    if [ -r "$CONF" ]; then
        awk -v k="$1" -F= '
            /^[[:space:]]*#/ { next }
            $1==k { sub(/^[^=]*=/,""); gsub(/^"|"$/,""); print; exit }
        ' "$CONF"
    fi
}

emit_json_current() {
    printf 'Content-Type: application/json\r\n\r\n'
    printf '{'
    printf '"MQTT_HOST":"%s",'  "$(read_conf_value MQTT_HOST)"
    printf '"MQTT_PORT":"%s",'  "$(read_conf_value MQTT_PORT)"
    printf '"MQTT_USER":"%s",'  "$(read_conf_value MQTT_USER)"
    if [ -n "$(read_conf_value MQTT_PASS)" ]; then
        printf '"MQTT_PASS":"********",'
    else
        printf '"MQTT_PASS":"",'
    fi
    printf '"INTERVAL":"%s",'   "$(read_conf_value INTERVAL)"
    printf '"DEVICE_ID":"%s",'  "$(read_conf_value DEVICE_ID)"
    printf '"KEEPALIVE":"%s"'   "$(read_conf_value KEEPALIVE)"
    printf '}'
}

emit_status_text() {
    printf 'Status: %s\r\n' "$1"
    printf 'Content-Type: text/plain\r\n\r\n'
    printf '%s\n' "$2"
}

emit_redirect() {
    printf 'Status: 303 See Other\r\n'
    printf 'Location: %s\r\n\r\n' "$1"
}

# ── dispatch ────────────────────────────────────────────────────────────────
case "${REQUEST_METHOD:-GET}" in
    GET)
        case "${QUERY_STRING:-}" in
            *format=json*) emit_json_current; exit 0 ;;
            *) emit_redirect "/"; exit 0 ;;
        esac
        ;;
    POST)
        : "${CONTENT_LENGTH:=0}"
        if [ "$CONTENT_LENGTH" -gt 16384 ]; then
            emit_status_text "413 Payload Too Large" "body too large"
            exit 0
        fi
        body=$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)

        tmpconf=$(mktemp /tmp/mqttreporter-conf.XXXXXX) || {
            emit_status_text "500 Server Error" "tmp failed"
            exit 0
        }

        # Carry over the example file's leading comment block (if any).
        if [ -r "$EXAMPLE" ]; then
            awk '/^#/{print; next} /^[[:space:]]*$/{print; next} {exit}' "$EXAMPLE" > "$tmpconf"
        else
            printf '# Generated by web-config\n' > "$tmpconf"
        fi

        # Split on & and write each key.
        old_ifs=$IFS
        IFS='&'
        # shellcheck disable=SC2086
        set -- $body
        IFS=$old_ifs
        for pair in "$@"; do
            key=${pair%%=*}
            raw=${pair#*=}
            [ "$key" = "$pair" ] && continue   # malformed (no '=')
            val=$(url_decode "$raw")

            # Preserve existing password if the form sent the placeholder.
            if [ "$key" = "MQTT_PASS" ] && [ "$val" = "********" ]; then
                existing=$(read_conf_value MQTT_PASS)
                if [ -n "$existing" ]; then
                    printf '%s="%s"\n' "$key" "$(sh_quote "$existing")" >> "$tmpconf"
                fi
                continue
            fi

            # Empty user/pass = anonymous broker.
            if [ -z "$val" ] && { [ "$key" = "MQTT_PASS" ] || [ "$key" = "MQTT_USER" ]; }; then
                printf '%s=""\n' "$key" >> "$tmpconf"
                continue
            fi

            checked=$(validate "$key" "$val") || {
                rm -f "$tmpconf"
                emit_status_text "400 Bad Request" "invalid value for $key"
                exit 0
            }
            printf '%s="%s"\n' "$key" "$(sh_quote "$checked")" >> "$tmpconf"
        done

        mv -f "$tmpconf" "$CONF"
        chmod 0640 "$CONF" 2>/dev/null || true

        # Restart daemon to pick up the new config.
        if [ -r "$APP_DIR/scripts/toggle.sh" ]; then
            (
                . "$APP_DIR/scripts/toggle.sh"
                do_stop
                do_start
            ) >/dev/null 2>&1
        fi

        emit_redirect "/?saved=1"
        ;;
    *)
        emit_status_text "405 Method Not Allowed" "method not allowed"
        ;;
esac
