#!/bin/sh
# CGI: per-entity opt-in / opt-out.
#
# GET ?format=json
#   Returns { entities: [{key,component,label,enabled}, ...] } sourced from
#   the _emit lines in discovery.sh, with `enabled` decided by etc/entities.conf
#   (missing file = all enabled).
#
# POST application/x-www-form-urlencoded
#   Body fields: entity_<key>=on for each checked box, e.g.
#     entity_battery=on&entity_volume=on
#   Writes etc/entities.conf with the listed keys (one per line) and
#   restarts the daemon.
# shellcheck shell=sh disable=SC1091
set -u

APP_DIR="${APP_DIR:-/mnt/SDCARD/App/MQTTReporter}"
ENT_CONF="$APP_DIR/etc/entities.conf"
DISCOVERY="$APP_DIR/scripts/discovery.sh"

# Parse the _emit lines in discovery.sh into "key<TAB>component<TAB>label".
# A line looks like:
#   _emit "$did" sensor   battery   "Miyoo Battery"  "%" "{{...}}" "mdi:..." ""
list_entities() {
    awk '
        /^[[:space:]]*_emit[[:space:]]/ {
            # Grab the 3rd whitespace token (component) and 4th (object_id).
            # awks 1=_emit  2="$did"  3=<comp>  4=<obj>
            comp = $3
            obj  = $4
            # Extract the first double-quoted string after $obj as label.
            line = $0
            # Trim everything up to and including the obj token.
            n = index(line, obj)
            if (n == 0) next
            rest = substr(line, n + length(obj))
            # Now grab the first "..."
            m = match(rest, /"[^"]*"/)
            if (m == 0) next
            label = substr(rest, RSTART + 1, RLENGTH - 2)
            printf "%s\t%s\t%s\n", obj, comp, label
        }
    ' "$DISCOVERY"
}

# Whitelist check — `key` may only contain [A-Za-z0-9_].
valid_key() {
    case "$1" in
        '' ) return 1 ;;
        *[!A-Za-z0-9_]* ) return 1 ;;
        *) return 0 ;;
    esac
}

is_enabled_in_conf() {
    # All-on if file missing.
    if [ ! -r "$ENT_CONF" ]; then
        echo true
        return
    fi
    if grep -qE "^[[:space:]]*$1[[:space:]]*\$" "$ENT_CONF"; then
        echo true
    else
        echo false
    fi
}

url_decode() {
    awk -v s="$1" 'BEGIN{
        for (k=0; k<16; k++) hex[sprintf("%X", k)] = k
        for (k=10; k<16; k++) hex[sprintf("%x", k)] = k
        gsub(/\+/, " ", s)
        out = ""; n = length(s); i = 1
        while (i <= n) {
            c = substr(s, i, 1)
            if (c == "%" && i + 2 <= n) {
                h1 = substr(s, i+1, 1)
                h2 = substr(s, i+2, 1)
                if (h1 in hex && h2 in hex) {
                    out = out sprintf("%c", hex[h1] * 16 + hex[h2])
                    i += 3
                    continue
                }
            }
            out = out c
            i++
        }
        print out
    }'
}

emit_json() {
    printf 'Content-Type: application/json\r\n\r\n'
    printf '{"entities":['
    first=1
    list_entities | while IFS='	' read -r key comp label; do
        en=$(is_enabled_in_conf "$key")
        if [ "$first" -eq 1 ]; then
            first=0
        else
            printf ','
        fi
        # Escape backslashes and double-quotes in label for JSON.
        label_esc=$(printf '%s' "$label" | sed -e 's|\\|\\\\|g' -e 's|"|\\"|g')
        printf '{"key":"%s","component":"%s","label":"%s","enabled":%s}' \
            "$key" "$comp" "$label_esc" "$en"
    done
    printf ']}'
}

emit_text() {
    printf 'Status: %s\r\n' "$1"
    printf 'Content-Type: text/plain\r\n\r\n%s\n' "$2"
}

emit_redirect() {
    printf 'Status: 303 See Other\r\n'
    printf 'Location: %s\r\n\r\n' "$1"
}

case "${REQUEST_METHOD:-GET}" in
    GET)
        emit_json
        ;;
    POST)
        : "${CONTENT_LENGTH:=0}"
        if [ "$CONTENT_LENGTH" -gt 32768 ]; then
            emit_text "413 Payload Too Large" "body too large"
            exit 0
        fi
        body=$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)

        tmp=$(mktemp /tmp/mqttreporter-ent.XXXXXX) || {
            emit_text "500 Server Error" "tmp failed"; exit 0;
        }
        printf '# Generated by web-config — one entity key per line.\n' > "$tmp"
        printf '# Delete this file to re-enable everything by default.\n' >> "$tmp"

        # Iterate body pairs.
        old_ifs=$IFS
        IFS='&'
        # shellcheck disable=SC2086
        set -- $body
        IFS=$old_ifs
        for pair in "$@"; do
            key_field=${pair%%=*}
            val=${pair#*=}
            case "$key_field" in
                entity_*)
                    raw_key=${key_field#entity_}
                    decoded=$(url_decode "$raw_key")
                    if valid_key "$decoded" && [ "$(url_decode "$val")" = "on" ]; then
                        printf '%s\n' "$decoded" >> "$tmp"
                    fi
                    ;;
                *) : ;;
            esac
        done

        mv -f "$tmp" "$ENT_CONF"
        chmod 0640 "$ENT_CONF" 2>/dev/null || true

        # Restart the daemon so the new discovery configs land in HA.
        if [ -r "$APP_DIR/scripts/toggle.sh" ]; then
            (
                export APP_DIR
                . "$APP_DIR/scripts/toggle.sh"
                do_stop
                do_start
            ) >/dev/null 2>&1
        fi

        emit_redirect "/?entities_saved=1"
        ;;
    *)
        emit_text "405 Method Not Allowed" "method not allowed"
        ;;
esac
